# Environment Configuration Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# Application Environment
VITE_APP_ENV=development
VITE_APP_NAME=Fuliza Limit Check
VITE_APP_URL=http://localhost:5173

# Paystack Configuration
# Get your keys from: https://dashboard.paystack.com/#/settings/developer
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# M-Pesa Configuration (Safaricom Daraja API)
# Get credentials from: https://developer.safaricom.co.ke
VITE_MPESA_ENVIRONMENT=sandbox
VITE_MPESA_BUSINESS_SHORTCODE=174379
VITE_MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Callback URLs (Update with your actual domain in production)
VITE_MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback
VITE_MPESA_TIMEOUT_URL=https://yourdomain.com/api/mpesa/timeout
VITE_MPESA_RESULT_URL=https://yourdomain.com/api/mpesa/result
VITE_PAYSTACK_CALLBACK_URL=https://yourdomain.com/api/paystack/callback

# Security Configuration
VITE_ENCRYPTION_KEY=your_32_character_encryption_key_here
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here

# Database Configuration (if using backend)
DATABASE_URL=postgresql://user:password@localhost:5432/fuliza_db
REDIS_URL=redis://localhost:6379

# API Configuration
API_BASE_URL=http://localhost:3000/api
API_TIMEOUT=30000

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_here

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_AUDIT_LOGS=true
VITE_ENABLE_RATE_LIMITING=true

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@yourdomain.com

# SMS Configuration (for notifications)
SMS_PROVIDER=africastalking
SMS_API_KEY=your_sms_api_key_here
SMS_USERNAME=your_sms_username_here

# Production Settings (uncomment for production)
# VITE_APP_ENV=production
# VITE_MPESA_ENVIRONMENT=production
# VITE_MPESA_BUSINESS_SHORTCODE=your_live_shortcode
# VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_live_key_here